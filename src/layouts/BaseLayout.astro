---
import '../styles/global.css';
import '../styles/editorial.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../data/site';

// Launch assets are optional: a tag is emitted only when the owner-approved file exists in public/ (QA-14).
const has = (f: string) => fs.existsSync(path.resolve("public", f));
const ogImage = has('og-image.png');
const touchIcon = has('apple-touch-icon.png');
const png192 = has('icon-192.png');

interface Props {
  title: string;
  description: string;
  /** Mark the page `noindex` (e.g. 404). */
  noindex?: boolean;
  /** Preload the italic display face (pages that use italic headings). */
  preloadItalic?: boolean;
}
const { title, description, noindex = false, preloadItalic = false } = Astro.props;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {png192 && <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />}
    {touchIcon && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
    <link rel="preload" href="/fonts/InstrumentSerif-Regular.woff2" as="font" type="font/woff2" crossorigin />
    {preloadItalic && <link rel="preload" href="/fonts/InstrumentSerif-Italic.woff2" as="font" type="font/woff2" crossorigin />}
    <meta name="theme-color" content="#0b0a09" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={new URL("/og-image.png", Astro.site).href} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        // Scroll reveal: purely progressive; content is visible without this script.
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); }
        else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
          }, { rootMargin: '0px 0px -8% 0px' });
          els.forEach(function (e) { io.observe(e); });
        }
        // Mobile menu: Escape closes it and returns focus to the Menu button.
        document.addEventListener('keydown', function (e) {
          if (e.key !== 'Escape') return;
          var m = document.querySelector('.nav-menu[open]');
          if (m) { m.removeAttribute('open'); var s = m.querySelector('summary'); if (s) s.focus(); }
        });
        // Media fallback: if a plate image fails, show the labelled placeholder instead.
        document.querySelectorAll('.plate img').forEach(function (img) {
          function fail() { img.closest('.plate').setAttribute('data-state', 'failed'); }
          if (img.complete && img.naturalWidth === 0) fail(); else img.addEventListener('error', fail);
        });
      })();
    </script>
  </body>
</html>
