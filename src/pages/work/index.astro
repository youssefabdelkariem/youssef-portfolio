---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Plate from '../../components/Plate.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SlotCard from '../../components/SlotCard.astro';
import { picture } from '../../data/media';
import { workProjects, workSlots, type Discipline } from '../../data/projects';

const featuredPic = picture('phone', 'The back of the Aurelia One smartphone floating in a dark studio, showing two camera lenses and the engraved AURELIA ONE mark.', '(min-width: 900px) 58vw, 100vw');

const groups: { discipline: Discipline; intro: string }[] = [
  { discipline: 'CGI', intro: '3D rendering, product visualization and CGI film work.' },
  { discipline: 'Compositing', intro: 'Compositing work and shot breakdowns showing how finished frames were assembled.' },
];
---

<BaseLayout title="VFX Portfolio" description="CGI, 3D rendering and compositing work, led by Aurelia, a CGI smartphone commercial.">
  <div class="wrap page-title">
    <p class="eyebrow">VFX Portfolio</p>
    <h1>CGI and compositing</h1>
    <p class="lede">A dedicated index of CGI and VFX work. Aurelia leads; further projects appear only once their material is verified.</p>
  </div>

  <section class="section" style="padding-top:0" aria-labelledby="featured-work">
    <div class="wrap work-feature">
      <div class="reveal">
        <Plate label="Aurelia" pic={featuredPic} ratio="16 / 9" framed />
      </div>
      <div class="reveal">
        <p class="eyebrow">Featured project</p>
        <h2 id="featured-work">Aurelia</h2>
        <p>A CGI smartphone commercial for the Aurelia One. The case study covers selected renders, the lighting and materials, a render-pass breakdown and the rendering and compositing workflow.</p>
        <ul class="chips" aria-label="Disciplines">
          <li>CGI</li><li>3D rendering</li><li>Compositing</li>
        </ul>
        <div class="actions" style="margin-top:1.5rem">
          <a class="btn" href="/work/aurelia/">View case study</a>
        </div>
      </div>
    </div>
  </section>

  {groups.map((g) => {
    const items = workProjects.filter((p) => p.discipline === g.discipline);
    const slots = workSlots.filter((s) => s.discipline === g.discipline);
    return (
      <section class="section divided" style="padding-block:clamp(2.5rem,6vw,5rem)" aria-labelledby={`g-${g.discipline}`}>
        <div class="wrap">
          <div class="section-head">
            <h2 id={`g-${g.discipline}`}>{g.discipline}</h2>
            <p style="margin:0">{g.intro}</p>
          </div>
          <div class="grid">
            {items.map((p) => <ProjectCard project={p} />)}
            {slots.map((s) => <SlotCard title={s.note} note="Appears here when real work is verified" />)}
          </div>
        </div>
      </section>
    );
  })}

  <div class="wrap section divided" style="padding-block:clamp(2rem,5vw,4rem)">
    <p class="notice"><strong>Showreel.</strong> No reel is published. A reel appears only when approved footage, shot credits and accessible alternatives exist.</p>
  </div>
</BaseLayout>
