---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pending from '../components/Pending.astro';
---

<BaseLayout title="Contact" description="How to contact Youssef Studio. Contact details pending owner approval.">
  <div class="wrap page-title">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="lede">For collaborations, commissions and technical conversations.</p>
  </div>
  <section class="section" style="padding-top:0" aria-labelledby="channel">
    <div class="wrap">
      <h2 id="channel">Contact channel</h2>
      <Pending what="Contact destination pending.">An owner-approved email address or profile link will be shown here as a plain, labelled link (FR-05b, Q05). No form is used, so no data is collected.</Pending>
    </div>
  </section>
</BaseLayout>
