---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page does not exist." noindex>
  <div class="wrap page-title">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lede">That address does not match a page on this site.</p>
    <div class="actions">
      <a class="btn" href="/">Home</a>
      <a class="btn ghost" href="/work/">VFX Portfolio</a>
      <a class="btn ghost" href="/engineering/">Engineering</a>
    </div>
  </div>
</BaseLayout>
