---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/software.css';
import Plate from '../components/Plate.astro';
import LapSparkline from '../components/LapSparkline.astro';
import { site } from '../data/site';
import { homeMedia } from '../data/home';
import ProjectTile from '../components/ProjectTile.astro';
import { projects } from '../data/early-projects';
import { framesentry } from '../data/framesentry';

const { hero, aurelia } = homeMedia;
const disciplines = [
  ['CGI and 3D rendering', 'Product visualization and cinematic imagery'],
  ['VFX and compositing', 'Shot breakdowns that show how frames were built'],
  ['Engineering and autonomy', 'Mechatronics and CAD foundations, and a documented autonomous-racing project'],
];
import { published as walkthroughPublished } from '../data/walkthrough';
import { contact } from '../data/contact';
---

<BaseLayout title={site.name} description={site.description} preloadItalic>
  <section class="hero" aria-labelledby="hero-title">
    <Plate label="Hero still" priority gate pic={hero} focal="52% 50%" />
    {walkthroughPublished && <a class="btn hero-cta" href="/work/aurelia/walkthrough/">View the full walkthrough <span aria-hidden="true">&rarr;</span></a>}
    <div class="hero-copy">
      <p class="eyebrow">CGI &middot; 3D rendering &middot; VFX &middot; Engineering</p>
      <h1 id="hero-title"><span>Engineering precision.</span> <span><em>Cinematic imagination.</em></span></h1>
      <p class="lede">A portfolio of CGI, 3D rendering and VFX work, grounded in mechatronics engineering and CAD.</p>
      <div class="actions">
        <a class="btn" href="/work/aurelia/">View Aurelia</a>
        {walkthroughPublished && <a class="btn ghost" href="/work/aurelia/walkthrough/">View the full walkthrough</a>}
        <a class="btn ghost" href="/work/">VFX Portfolio</a>
      </div>
    </div>
  </section>

  <section class="section divided" aria-labelledby="intro-title">
    <div class="wrap intro reveal">
      <h2 id="intro-title">Cinematic images, built with engineering discipline.</h2>
      <ul>
        {disciplines.map(([name, note]) => <li><strong>{name}</strong><span>{note}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section divided" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="reveal">
        <Plate label="Aurelia" framed ratio="16 / 9" pic={aurelia} />
      </div>
      <div class="featured-body reveal">
        <div>
          <p class="eyebrow">Featured project</p>
          <h2 id="featured-title">Aurelia</h2>
        </div>
        <div>
          <p>A CGI smartphone commercial and the flagship of this portfolio, with selected renders, a render-pass breakdown and the technical notes behind it.</p>
          <div class="actions">
            <a class="btn" href="/work/aurelia/">View case study</a>
            {walkthroughPublished && <a class="btn ghost" href="/work/aurelia/walkthrough/">View the full walkthrough</a>}
          </div>
        </div>
        <dl>
          <div><dt>Type</dt><dd>CGI smartphone commercial</dd></div>
          <div><dt>Format</dt><dd>3840 x 2160, 24 fps</dd></div>
          <div><dt>Built with</dt><dd>Blender (Cycles), Nuke</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section divided" aria-labelledby="earlier-title">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 id="earlier-title">Earlier work</h2>
        <a href="/work/#more">All nine projects</a>
      </div>
      <p class="lede reveal" style="margin-bottom:var(--s-6)">Personal projects from the learning stage: cars, an aircraft, a helicopter, a boat, a rolling steel ball and spaceships, each with its own page.</p>
      <div class="tiles">
        {projects.slice(0, 3).map((p) => <ProjectTile project={p} />)}
      </div>
    </div>
  </section>

  <section class="section tech" aria-labelledby="eng-title">
    <div class="wrap tech-grid">
      <div class="reveal">
        <p class="eyebrow">Engineering</p>
        <h2 id="eng-title">Engineering and autonomous racing</h2>
        <p class="lede">The IBM AI Racing League / TORCS controller: a locally validated 65.968-second lap, measured telemetry and a full technical case study.</p>
        <ol class="idx">
          <li><span class="n">01</span><a href="/engineering/">Engineering</a><span class="d">Projects with evidence</span></li>
          <li><span class="n">02</span><a href="/engineering/ibm-ai-racing/">IBM AI Racing League / TORCS</a><span class="d">Autonomous racing &middot; locally validated 65.968 s lap</span></li>
        </ol>
      </div>
      <div class="reveal">
        <LapSparkline />
      </div>
    </div>
  </section>

  <section class="section divided" aria-labelledby="software-title">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 id="software-title">Featured Software</h2>
        <a href="/software/">Software</a>
      </div>
      <article class="sw-feature-card reveal">
        <div>
          <div class="sw-brand-lockup">
            <img class="sw-icon" src={framesentry.assets.icon} alt="" width="44" height="44" />
            <span class="sw-badge">In development</span>
          </div>
          <p class="eyebrow" style="margin-bottom: var(--s-2)">{framesentry.category}</p>
          <h3>{framesentry.name}</h3>
          <p>{framesentry.headline} {framesentry.supporting}</p>
          <div class="actions" style="margin-top:var(--s-5)">
            <a class="btn" href="/software/framesentry/">Explore FrameSentry</a>
            {contact.enabled && <a class="btn ghost" href="/contact/">Contact for Early Access</a>}
          </div>
        </div>
        <figure class="sw-feature-media" style="margin:0">
          <img src={framesentry.assets.banner} alt={framesentry.assets.bannerAlt} width="2172" height="724" />
        </figure>
      </article>
    </div>
  </section>

  <section class="section cta-band" aria-labelledby="cta-title">
    <div class="wrap reveal">
      <h2 id="cta-title">See the work in full.</h2>
      <p>Two projects, each documented with its evidence.</p>
      <div class="actions">
        <a class="btn" href="/work/aurelia/">Aurelia</a>
        <a class="btn ghost" href="/engineering/ibm-ai-racing/">IBM AI Racing</a>
        <a class="btn ghost" href="/about/">About</a>
        {contact.enabled && <a class="btn" href="/contact/">Hire me</a>}
      </div>
    </div>
  </section>
</BaseLayout>
