---
import '../../../styles/software.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FrameSentryScanner from '../../../components/FrameSentryScanner.astro';
import FrameSentryVideos from '../../../components/FrameSentryVideos.astro';
import { framesentry } from '../../../data/framesentry';
import release from '../../../data/framesentry-release.json';

const checkoutReady = release.checkout.enabled && !!release.checkout.checkoutUrl;
---

<BaseLayout
  title="FrameSentry — Render Sequence QC for Blender"
  description="FrameSentry helps Blender artists and studios inspect rendered sequences, catch missing or corrupt frames, and review findings before compositing or delivery."
>
  <!-- 1. Hero and product identity -->
  <section class="sw-hero" aria-labelledby="fs-title">
    <div class="wrap sw-hero-grid">
      <div>
        <div class="sw-brand-lockup">
          <img class="sw-icon" src={framesentry.assets.icon} alt={framesentry.assets.iconAlt} width="44" height="44" />
          <span class="sw-badge">{framesentry.statusLabel}</span>
        </div>
        <p class="eyebrow">{framesentry.category}</p>
        <h1 id="fs-title">{framesentry.headline}</h1>
        <p class="lede">{framesentry.supporting}</p>
        <div class="actions">
          {checkoutReady && (
            <a class="btn" href={release.checkout.checkoutUrl!} rel="noopener">{release.checkout.ctaLabel}</a>
          )}
          <a class="btn ghost" href="#how-it-works">See How It Works</a>
          <a class="btn ghost" href="#demo">Watch Demos</a>
        </div>
      </div>

      <figure class="sw-banner-card">
        <img src={framesentry.assets.banner} alt={framesentry.assets.bannerAlt} width="1440" height="480" decoding="async" />
        <dl class="sw-banner-meta">
          <div>
            <dt>Architecture</dt>
            <dd>Blender Adapter + Isolated Engine</dd>
          </div>
          <div>
            <dt>Target Blender</dt>
            <dd>4.5.15 LTS, 5.2.x, 5.3.x</dd>
          </div>
          <div>
            <dt>Operation</dt>
            <dd>Offline-first, strictly read-only</dd>
          </div>
          <div>
            <dt>Release status</dt>
            <dd>Available on Gumroad</dd>
          </div>
        </dl>
      </figure>
    </div>
  </section>

  <!-- 2. Interactive animated explainer: how FrameSentry inspects a sequence -->
  <section class="sw-section" id="how-it-works" aria-labelledby="how-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>01</span><span>How FrameSentry works</span></p>
      <h2 id="how-title" class="reveal">Every frame decoded out-of-process. Every defect pinpointed.</h2>
      <p class="lede reveal" style="margin-bottom:var(--s-6)">
        Watch how FrameSentry scans a 48-frame EXR sequence without freezing Blender — separating deterministic structural errors from heuristic visual anomalies, then outputting the exact frames to re-render. Click any finding to jump directly to that frame.
      </p>
      <div class="reveal">
        <FrameSentryScanner />
      </div>
    </div>
  </section>

  <!-- 3. Why render-sequence QC matters -->
  <section class="sw-section" id="why-qc" aria-labelledby="why-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>02</span><span>Why render-sequence QC matters</span></p>
      <h2 id="why-title" class="reveal">Catch silent frame defects before delivery.</h2>
      <p class="lede reveal">{framesentry.whyMatters.lead}</p>
      <ul class="sw-points reveal">
        {framesentry.whyMatters.points.map((pt) => (
          <li>
            <h3>{pt.title}</h3>
            <p>{pt.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. Features and supported inspection workflows -->
  <section class="sw-section" id="workflows" aria-labelledby="workflows-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>03</span><span>Features &amp; inspection workflows</span></p>
      <h2 id="workflows-title" class="reveal">Verified structural facts and heuristic visual checks.</h2>
      <div class="sw-workflows reveal">
        {framesentry.workflows.map((wf) => (
          <article class="sw-card">
            <span class="sw-tag">{wf.tag}</span>
            <h3>{wf.title}</h3>
            <p>{wf.summary}</p>
            <ul>
              {wf.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Real-world video demonstrations -->
  <section class="sw-section" id="demo" aria-labelledby="demo-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>04</span><span>Real-world demonstrations</span></p>
      <h2 id="demo-title" class="reveal">See FrameSentry running inside Blender.</h2>
      <p class="lede reveal" style="margin-bottom:var(--s-6)">
        The overview film and a real-world Blender walkthrough inspecting an Aurelia EXR render sequence from discovery to re-render list export.
      </p>
      <div class="reveal">
        <FrameSentryVideos videos={framesentry.videos} />
      </div>
    </div>
  </section>

  <!-- 6. FrameSentry interface gallery -->
  <section class="sw-section" id="gallery" aria-labelledby="gallery-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>05</span><span>FrameSentry interface gallery</span></p>
      <h2 id="gallery-title" class="reveal">Built for Blender’s Output and Image Editor workflow.</h2>
      <p class="lede reveal" style="margin-bottom:var(--s-6)">
        Captured in Blender 4.5.15 LTS (Windows OpenGL) inspecting a 48-frame Aurelia EXR sequence.
      </p>
      <div class="sw-gallery reveal">
        {framesentry.gallerySlots.map((slot) => (
          <figure class="sw-slot">
            <img class="sw-slot-img" src={slot.image} alt={slot.alt} width="1440" height="810" loading="lazy" decoding="async" />
            <figcaption>
              <span class="sw-slot-step">{slot.step} &middot; {slot.area}</span>
              <strong>{slot.title}</strong>
              <span>{slot.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Blender compatibility and release status -->
  <section class="sw-section" id="compatibility" aria-labelledby="compat-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>06</span><span>Blender compatibility &amp; release status</span></p>
      <h2 id="compat-title" class="reveal">Targeted versions and qualification gates.</h2>
      <div class="sw-callout reveal">
        <p><strong>Verified today:</strong> Blender 4.5.15 LTS on Windows OpenGL is verified end-to-end with the Aurelia EXR sequence.</p>
        <p><strong>Release status:</strong> {framesentry.compatibility.milestoneNote}</p>
        <p><strong>GPU Findings Preview gate:</strong> {framesentry.compatibility.gpuGateNote}</p>
      </div>
      <div class="table-wrap reveal" role="region" aria-labelledby="compat-cap" tabindex="0">
        <table>
          <caption id="compat-cap">Targeted Blender versions and current qualification status</caption>
          <thead>
            <tr>
              <th scope="col">Blender Version</th>
              <th scope="col">Target Tier</th>
              <th scope="col">Qualification Status</th>
              <th scope="col">Scope &amp; Notes</th>
            </tr>
          </thead>
          <tbody>
            {framesentry.compatibility.matrix.map((row) => (
              <tr>
                <th scope="row" class="mono">{row.version}</th>
                <td>{row.tier}</td>
                <td>{row.status}</td>
                <td>{row.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div style="margin-top:var(--s-6)" class="reveal">
        <p class="eyebrow" style="margin-bottom:var(--s-3)">Target input formats</p>
        <ul class="chips">
          {framesentry.compatibility.formats.map((fmt) => <li>{fmt}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 8. Purchasing section -->
  <section class="sw-section" id="purchase" aria-labelledby="purchase-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>07</span><span>Availability &amp; licensing</span></p>
      <h2 id="purchase-title" class="reveal">Get FrameSentry on Gumroad.</h2>
      <div class="sw-purchase reveal">
        <div>
          <span class="sw-badge">{framesentry.purchasing.status}</span>
          <h3>Available now for Blender.</h3>
          <p>{framesentry.purchasing.summary}</p>
          <div class="actions" style="margin-top:var(--s-5)">
            {checkoutReady && (
              <a class="btn" href={release.checkout.checkoutUrl!} rel="noopener">{release.checkout.ctaLabel}</a>
            )}
            <a class="btn ghost" href="/software/">All Software</a>
          </div>
        </div>
        <div class="sw-purchase-box">
          <p class="eyebrow" style="margin:0">Included</p>
          <ul class="sw-purchase-list">
            {framesentry.purchasing.deliverables.map((d) => <li>{d}</li>)}
          </ul>
          <p style="margin:0; font-size:0.875rem; color:var(--text-2)">
            Direct download and updates via Gumroad.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Frequently asked questions -->
  <section class="sw-section" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>08</span><span>Frequently asked questions</span></p>
      <h2 id="faq-title" class="reveal">Common questions</h2>
      <div class="sw-faq reveal">
        {framesentry.faqs.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
