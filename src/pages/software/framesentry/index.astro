---
import '../../../styles/software.css';
import '../../../styles/contact.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { framesentry } from '../../../data/framesentry';
import { contact } from '../../../data/contact';
import release from '../../../data/framesentry-release.json';

const autoSend = release.beta.mode === 'auto-send';
const checkoutReady = release.checkout.enabled && !!release.checkout.checkoutUrl;
---

<BaseLayout
  title="FrameSentry — Render Sequence QC for Blender"
  description="FrameSentry helps Blender artists and studios inspect rendered sequences, catch missing or corrupt frames, and review findings before compositing or delivery."
>
  <!-- 1. Hero and product identity -->
  <section class="sw-hero" aria-labelledby="fs-title">
    <div class="wrap sw-hero-grid">
      <div>
        <div class="sw-brand-lockup">
          <img class="sw-icon" src={framesentry.assets.icon} alt={framesentry.assets.iconAlt} width="44" height="44" />
          <span class="sw-badge">{framesentry.statusLabel}</span>
        </div>
        <p class="eyebrow">{framesentry.category}</p>
        <h1 id="fs-title">{framesentry.headline}</h1>
        <p class="lede">{framesentry.supporting}</p>
        <div class="actions">
          {checkoutReady ? (
            <a class="btn" href={release.checkout.checkoutUrl!} rel="noopener">{release.checkout.ctaLabel}</a>
          ) : (
            <a class="btn" href="#beta">Apply for Beta</a>
          )}
          <a class="btn ghost" href="#purchase">Coming Soon</a>
          {contact.enabled && <a class="btn ghost" href="/contact/">Contact for Early Access</a>}
        </div>
      </div>

      <figure class="sw-banner-card">
        <img src={framesentry.assets.banner} alt={framesentry.assets.bannerAlt} width="1440" height="480" decoding="async" />
        <dl class="sw-banner-meta">
          <div>
            <dt>Architecture</dt>
            <dd>Blender Adapter + Isolated Engine</dd>
          </div>
          <div>
            <dt>Target Blender</dt>
            <dd>4.5.15 LTS, 5.2.x, 5.3.x</dd>
          </div>
          <div>
            <dt>Operation</dt>
            <dd>Offline-first, strictly read-only</dd>
          </div>
          <div>
            <dt>Release status</dt>
            <dd>M4 closed w/ conditions; v1.0 in qualification</dd>
          </div>
        </dl>
      </figure>
    </div>
  </section>

  <!-- 2. Why render-sequence QC matters -->
  <section class="sw-section" id="why-qc" aria-labelledby="why-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>01</span><span>Why render-sequence QC matters</span></p>
      <h2 id="why-title" class="reveal">Catch silent frame defects before delivery.</h2>
      <p class="lede reveal">{framesentry.whyMatters.lead}</p>
      <ul class="sw-points reveal">
        {framesentry.whyMatters.points.map((pt) => (
          <li>
            <h3>{pt.title}</h3>
            <p>{pt.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Features and supported inspection workflows -->
  <section class="sw-section" id="workflows" aria-labelledby="workflows-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>02</span><span>Features &amp; inspection workflows</span></p>
      <h2 id="workflows-title" class="reveal">Verified structural facts and heuristic visual checks.</h2>
      <div class="sw-workflows reveal">
        {framesentry.workflows.map((wf) => (
          <article class="sw-card">
            <span class="sw-tag">{wf.tag}</span>
            <h3>{wf.title}</h3>
            <p>{wf.summary}</p>
            <ul>
              {wf.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. FrameSentry interface gallery -->
  <section class="sw-section" id="gallery" aria-labelledby="gallery-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>03</span><span>FrameSentry interface gallery</span></p>
      <h2 id="gallery-title" class="reveal">Built for Blender’s Output and Image Editor workflow.</h2>
      <p class="lede reveal" style="margin-bottom:var(--s-6)">
        Captured directly from the M4 development build running in Blender 4.5.15 LTS (Windows OpenGL) on a 48-frame Aurelia EXR sequence.
      </p>
      <div class="sw-gallery reveal">
        {framesentry.gallerySlots.map((slot) => (
          <figure class="sw-slot">
            <img class="sw-slot-img" src={slot.image} alt={slot.alt} width="1440" height="810" loading="lazy" decoding="async" />
            <figcaption>
              <span class="sw-slot-step">{slot.step} &middot; {slot.area}</span>
              <strong>{slot.title}</strong>
              <span>{slot.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Real-world demonstration area -->
  <section class="sw-section" id="demo" aria-labelledby="demo-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>04</span><span>Real-world demonstration</span></p>
      <h2 id="demo-title" class="reveal">End-to-end sequence inspection walkthrough.</h2>
      <div class="sw-demo-box reveal">
        <video
          class="sw-demo-video"
          controls
          playsinline
          preload="none"
          poster={framesentry.demo.poster}
          width="1920"
          height="1080"
        >
          <source src={framesentry.demo.video} type="video/mp4" />
        </video>
        <div class="sw-demo-bar">
          <span>{framesentry.demo.caption}</span>
          <span>1080p &middot; 46 s &middot; Blender 4.5.15 LTS</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Blender compatibility and release status -->
  <section class="sw-section" id="compatibility" aria-labelledby="compat-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>05</span><span>Blender compatibility &amp; release status</span></p>
      <h2 id="compat-title" class="reveal">Targeted versions and qualification gates.</h2>
      <div class="sw-callout reveal">
        <p><strong>Release status:</strong> {framesentry.compatibility.milestoneNote}</p>
        <p><strong>GPU Findings Preview gate:</strong> {framesentry.compatibility.gpuGateNote}</p>
      </div>
      <div class="table-wrap reveal" role="region" aria-labelledby="compat-cap" tabindex="0">
        <table>
          <caption id="compat-cap">Targeted Blender versions and current qualification status</caption>
          <thead>
            <tr>
              <th scope="col">Blender Version</th>
              <th scope="col">Target Tier</th>
              <th scope="col">Qualification Status</th>
              <th scope="col">Scope &amp; Notes</th>
            </tr>
          </thead>
          <tbody>
            {framesentry.compatibility.matrix.map((row) => (
              <tr>
                <th scope="row" class="mono">{row.version}</th>
                <td>{row.tier}</td>
                <td>{row.status}</td>
                <td>{row.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div style="margin-top:var(--s-6)" class="reveal">
        <p class="eyebrow" style="margin-bottom:var(--s-3)">Target input formats</p>
        <ul class="chips">
          {framesentry.compatibility.formats.map((fmt) => <li>{fmt}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 7. Beta testing application -->
  {release.beta.enabled && (
    <section class="sw-section" id="beta" aria-labelledby="beta-title">
      <div class="wrap contact-grid">
        <aside class="contact-side reveal" aria-label="Beta testing details">
          <p class="sw-sec-label"><span>06</span><span>Beta testing</span></p>
          <h2 id="beta-title">Apply for the FrameSentry beta.</h2>
          <p>
            {autoSend
              ? 'Beta access is currently set to instant delivery. Submit your setup to receive the current beta build download link by email.'
              : 'Beta builds are distributed in controlled waves. Applications are reviewed manually before download links and checksums are emailed.'}
          </p>
          <ul class="chips" style="margin-top:var(--s-4)">
            <li>{autoSend ? 'Mode: Instant email delivery' : 'Mode: Manual approval'}</li>
            <li>Windows x64 &amp; Linux x86-64 (dev)</li>
            <li>Blender 4.5.15 LTS &amp; 5.2.x</li>
          </ul>
        </aside>

        <div class="reveal">
          <form id="beta-form" class="brief" method="post" action={release.beta.endpoint} novalidate>
            <p class="req-note">Fields marked <span aria-hidden="true">*</span><span class="sr">with an asterisk</span> are required.</p>
            <div class="row">
              <div class="field">
                <label for="b-name">Name <span aria-hidden="true">*</span></label>
                <input id="b-name" name="name" type="text" autocomplete="name" required maxlength="120" />
              </div>
              <div class="field">
                <label for="b-email">Email <span aria-hidden="true">*</span></label>
                <input id="b-email" name="email" type="email" autocomplete="email" required maxlength="200" />
              </div>
            </div>
            <div class="row">
              <div class="field">
                <label for="b-os">Operating System <span aria-hidden="true">*</span></label>
                <select id="b-os" name="operating_system" required>
                  <option value="">Choose one</option>
                  <option value="Windows x64">Windows x64</option>
                  <option value="Linux x86-64">Linux x86-64</option>
                  <option value="macOS (qualification pending)">macOS (qualification pending)</option>
                </select>
              </div>
              <div class="field">
                <label for="b-blender">Primary Blender Version <span aria-hidden="true">*</span></label>
                <select id="b-blender" name="blender_version" required>
                  <option value="">Choose one</option>
                  <option value="Blender 4.5.15 LTS">Blender 4.5.15 LTS</option>
                  <option value="Blender 5.2.x">Blender 5.2.x</option>
                  <option value="Blender 5.3.x">Blender 5.3.x</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="b-studio">Studio or Role <span class="opt">(optional)</span></label>
              <input id="b-studio" name="studio" type="text" autocomplete="organization" maxlength="160" />
            </div>
            <div class="field">
              <label for="b-workflow">Render workflow &amp; sequence formats <span aria-hidden="true">*</span></label>
              <textarea id="b-workflow" name="workflow" rows="5" required minlength="15" maxlength="3000" aria-describedby="b-workflow-help"></textarea>
              <p id="b-workflow-help" class="help">Tell us what formats you render (EXR, PNG, TIFF, JPEG), typical frame counts, and what issues you want to catch.</p>
            </div>
            <div class="field hp" aria-hidden="true">
              <label for="b-hp">Leave this empty</label>
              <input id="b-hp" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="_subject" value="FrameSentry Beta Application — youssef.studio" />
            <input type="hidden" name="beta_delivery_mode" value={release.beta.mode} />
            <div class="field consent">
              <label class="check">
                <input id="b-consent" name="consent" type="checkbox" value="yes" required />
                <span>I agree that this beta application is sent to Youssef Studio through Formspree and used only to review and coordinate FrameSentry beta access. <span aria-hidden="true">*</span></span>
              </label>
            </div>
            <div class="actions">
              <button class="btn" type="submit">Apply for Beta</button>
            </div>
            <p id="beta-status" class="status" role="status" aria-live="polite"></p>
          </form>
          <div id="beta-done" class="done notice" tabindex="-1" hidden>
            <h3>{autoSend ? 'Application received — check your inbox.' : 'Beta application received.'}</h3>
            <p>
              {autoSend
                ? 'Your beta download link and setup notes are on the way to the email address you provided.'
                : 'Thank you for applying. Your setup details are queued for manual review, and approved testers receive the beta build and checksums by email.'}
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 8. Future purchasing section (Lemon Squeezy ready) -->
  <section class="sw-section" id="purchase" aria-labelledby="purchase-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>07</span><span>Pre-orders &amp; licensing</span></p>
      <h2 id="purchase-title" class="reveal">Prepared for Lemon Squeezy pre-orders &amp; direct release.</h2>
      <div class="sw-purchase reveal">
        <div>
          <span class="sw-badge">{checkoutReady ? 'Pre-orders Open' : framesentry.purchasing.status}</span>
          <h3>{checkoutReady ? 'Pre-order FrameSentry 1.0.' : 'Pre-orders opening soon via Lemon Squeezy.'}</h3>
          <p>{framesentry.purchasing.summary}</p>
          <div class="actions" style="margin-top:var(--s-5)">
            {checkoutReady ? (
              <a class="btn" href={release.checkout.checkoutUrl!} rel="noopener">{release.checkout.ctaLabel}</a>
            ) : (
              <a class="btn" href="#beta">Apply for Beta</a>
            )}
            {contact.enabled && <a class="btn ghost" href="/contact/">Contact for Early Access</a>}
            <a class="btn ghost" href="/software/">All Software</a>
          </div>
        </div>
        <div class="sw-purchase-box">
          <p class="eyebrow" style="margin:0">Planned 1.0 deliverables</p>
          <ul class="sw-purchase-list">
            {framesentry.purchasing.deliverables.map((d) => <li>{d}</li>)}
          </ul>
          <p style="margin:0; font-size:0.875rem; color:var(--text-2)">
            {checkoutReady
              ? 'Checkout and licence delivery are handled securely via Lemon Squeezy.'
              : 'Checkout is configured for Lemon Squeezy and will go live once pre-orders open and pricing is finalized.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Frequently asked questions -->
  <section class="sw-section" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <p class="sw-sec-label reveal"><span>08</span><span>Frequently asked questions</span></p>
      <h2 id="faq-title" class="reveal">Common questions</h2>
      <div class="sw-faq reveal">
        {framesentry.faqs.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    import '../../../scripts/beta-form';
  </script>
</BaseLayout>
