---
/** Test fixture (local explore build only): the homepage hero with synthetic art, desktop and 4:5 mobile. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Plate from '../components/Plate.astro';

const pic = {
  id: 'fixture', alt: 'Synthetic hero fixture with a marked safe area', src: '/explore-fixtures/hero-desktop.svg', width: 2390, height: 1000, large: '', largeBytes: 0,
  sources: [{ type: 'image/svg+xml', srcset: '/explore-fixtures/hero-mobile.svg', media: '(max-width: 560px)' }],
};
---

<BaseLayout title="Hero fixture" description="Local test fixture for hero cropping and layout stability." noindex>
  <section class="hero" aria-labelledby="hero-title">
    <Plate label="Hero fixture" priority gate pic={pic} />
    <div class="hero-copy">
      <p class="eyebrow">Fixture</p>
      <h1 id="hero-title"><span>Engineering precision.</span> <span><em>Cinematic imagination.</em></span></h1>
      <p class="lede">Layout fixture for measuring crop and stability.</p>
    </div>
  </section>
</BaseLayout>
