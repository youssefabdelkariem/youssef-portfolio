---
import Shell from '../Shell.astro';

const links = [
  { href: '/explore/a/#work', label: 'Work' },
  { href: '/explore/a/#case', label: 'Case study' },
  { href: '/explore/a/#also', label: 'Engineering' },
  { href: '/contact/', label: 'Contact' },
];
---

<Shell
  title="Direction A: Cinematic Editorial (exploration)"
  description="Design exploration only. Placeholder content; not the site."
  themeColor="#0b0a09"
  rootClass="dir-a"
>
  <aside class="ribbon" aria-label="Exploration notice">Design exploration, direction A. Placeholder content only; not approved and not published.</aside>

  <header class="top">
    <a class="mark" href="/explore/a/" aria-label="YOUSSEF.STUDIO home">YOUSSEF<span>.</span>STUDIO</a>
    <nav class="links" aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Primary (menu)">
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="a-hero">
      <div class="plate" role="img" aria-label="Placeholder hero frame, 2.39 to 1. Aurelia hero still not yet approved.">
        <span class="streak" aria-hidden="true"></span>
        <span class="tag">Placeholder &middot; Aurelia hero still &middot; 2.39:1 &middot; not approved</span>
      </div>
      <div class="hero-copy">
        <p class="kicker">CGI &middot; 3D rendering &middot; VFX</p>
        <h1 id="a-hero"><span>Images that were</span> <em>never filmed.</em></h1>
        <p class="sample">Sample headline, not approved copy.</p>
      </div>
    </section>

    <section id="work" class="feature" aria-labelledby="a-feat">
      <div class="head reveal">
        <h2 id="a-feat">Selected work</h2>
        <p>Flagship first. Further projects appear only when verified.</p>
      </div>
      <div class="frames">
        <figure class="frame big reveal">
          <div class="ph" role="img" aria-label="Placeholder frame for Aurelia, not approved"><span>Placeholder &middot; Aurelia &middot; 2.39:1</span></div>
          <figcaption><span class="n">01</span><a href="/work/aurelia/">Aurelia</a><span class="m">Flagship CGI smartphone commercial</span></figcaption>
        </figure>
        <figure class="frame small reveal">
          <div class="ph slot" role="img" aria-label="Empty project slot"><span>Project slot &middot; no verified work yet</span></div>
          <figcaption><span class="n">02</span><span class="t">To be confirmed</span></figcaption>
        </figure>
        <figure class="frame small off reveal">
          <div class="ph slot" role="img" aria-label="Empty project slot"><span>Project slot &middot; no verified work yet</span></div>
          <figcaption><span class="n">03</span><span class="t">To be confirmed</span></figcaption>
        </figure>
      </div>
    </section>

    <section id="case" class="case" aria-labelledby="a-case">
      <div class="side reveal">
        <p class="kicker">Case study &middot; sample layout</p>
        <h2 id="a-case">Aurelia</h2>
        <dl>
          <div><dt>Role</dt><dd>Pending confirmation</dd></div>
          <div><dt>Credits</dt><dd>Pending confirmation</dd></div>
          <div><dt>Tools</dt><dd>Pending verification</dd></div>
        </dl>
      </div>
      <ol class="stages">
        <li class="reveal">
          <span class="n">i.</span>
          <div class="ph" role="img" aria-label="Placeholder: plate stage"><span>Placeholder &middot; plate</span></div>
          <p>Stage caption and the decision it shows, written from verified material.</p>
        </li>
        <li class="reveal">
          <span class="n">ii.</span>
          <div class="ph" role="img" aria-label="Placeholder: render stage"><span>Placeholder &middot; render</span></div>
          <p>Stage caption and the decision it shows, written from verified material.</p>
        </li>
        <li class="reveal">
          <span class="n">iii.</span>
          <div class="ph" role="img" aria-label="Placeholder: composite stage"><span>Placeholder &middot; composite</span></div>
          <p>Stage caption and the decision it shows, written from verified material.</p>
        </li>
      </ol>
    </section>

    <section id="also" class="also reveal" aria-labelledby="a-also">
      <h2 id="a-also">Also: engineering</h2>
      <p>Mechatronics, CAD and autonomous racing sit behind the creative work as a quieter second act.</p>
      <p class="links2"><a href="/engineering/">Engineering</a> <a href="/engineering/ibm-ai-racing/">IBM AI Racing League / TORCS</a></p>
    </section>
  </main>

  <footer class="foot"><span>YOUSSEF.STUDIO</span><span>Provisional exploration</span></footer>
</Shell>

<style is:global>
  .dir-a {
    --ink: #0b0a09; --panel: #141210; --bone: #ebe5da; --mute: #a39b8d; --brass: #c9a96e; --rule: #2e2924;
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --ease: cubic-bezier(.2, .7, .2, 1);
    color-scheme: dark;
  }
  .dir-a *, .dir-a *::before, .dir-a *::after { box-sizing: border-box; }
  .dir-a body { margin: 0; background: var(--ink); color: var(--bone); font: 1.0625rem/1.65 var(--sans); }
  .dir-a a { color: inherit; text-underline-offset: .22em; text-decoration-color: var(--brass); }
  .dir-a a:hover { color: var(--brass); }
  .dir-a :focus-visible { outline: 2px solid var(--brass); outline-offset: 4px; }
  .dir-a h1, .dir-a h2 { font-family: var(--serif); font-weight: 400; margin: 0; letter-spacing: -.02em; line-height: 1.02; text-wrap: balance; }
  .dir-a .ribbon { margin: 0; padding: 6px 16px; font-size: .75rem; letter-spacing: .06em; text-align: center; background: #1d1913; color: var(--mute); border-bottom: 1px solid var(--rule); }
  .dir-a .kicker { font: 600 .75rem/1 var(--sans); letter-spacing: .24em; text-transform: uppercase; color: var(--brass); margin: 0 0 20px; }

  /* navigation: centred wordmark, links split; mobile uses a no-JS <details> overlay */
  .dir-a .top { position: sticky; top: 0; z-index: 40; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 18px clamp(20px, 4vw, 56px); background: linear-gradient(var(--ink), rgb(11 10 9 / .0)); }
  .dir-a .mark { grid-column: 2; font: 400 .9375rem/1 var(--serif); letter-spacing: .34em; text-decoration: none; white-space: nowrap; }
  .dir-a .mark span { color: var(--brass); }
  .dir-a .links { grid-column: 3; justify-self: end; }
  .dir-a .links ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  .dir-a .links a { font: 500 .75rem/1 var(--sans); letter-spacing: .18em; text-transform: uppercase; text-decoration: none; padding: 12px 0; display: inline-block; background: linear-gradient(var(--brass), var(--brass)) left bottom / 0 1px no-repeat; transition: background-size .35s var(--ease); }
  .dir-a .links a:hover, .dir-a .links a:focus-visible { background-size: 100% 1px; color: var(--bone); }
  .dir-a .menu { display: none; grid-column: 3; justify-self: end; }
  .dir-a .menu summary { list-style: none; cursor: pointer; font: 500 .75rem/1 var(--sans); letter-spacing: .18em; text-transform: uppercase; padding: 14px 4px; min-height: 44px; }
  .dir-a .menu summary::-webkit-details-marker { display: none; }
  .dir-a .menu[open] > nav { position: fixed; inset: 0; z-index: 60; background: var(--ink); display: grid; align-content: center; padding: 0 28px; }
  .dir-a .menu[open] summary { position: fixed; top: 16px; right: 20px; z-index: 70; }
  .dir-a .menu ul { list-style: none; margin: 0; padding: 0; }
  .dir-a .menu li a { display: block; padding: 14px 0; font: 400 clamp(2rem, 9vw, 3rem)/1.1 var(--serif); text-decoration: none; border-bottom: 1px solid var(--rule); }

  /* hero: letterboxed plate on top, copy on solid ink below (no text over uncontrolled imagery) */
  .dir-a .hero { padding: 0 0 clamp(48px, 9vw, 120px); }
  .dir-a .plate { position: relative; overflow: hidden; aspect-ratio: 2.39 / 1; max-height: 68svh; width: 100%; background: radial-gradient(55% 110% at 60% 42%, #5a4326 0%, #2a2016 38%, #120f0b 70%, #0b0a09 100%); border-block: 1px solid var(--rule); display: grid; place-items: end start; }
  .dir-a .plate::after { content: ''; position: absolute; inset: 0; background: radial-gradient(120% 100% at 50% 50%, transparent 55%, rgb(0 0 0 / .65)); pointer-events: none; }
  .dir-a .streak { position: absolute; left: 0; right: 0; top: 46%; height: 2px; background: linear-gradient(90deg, transparent, rgb(201 169 110 / .0) 20%, rgb(255 236 200 / .85) 50%, rgb(201 169 110 / 0) 80%, transparent); filter: blur(.4px); box-shadow: 0 0 40px 6px rgb(201 169 110 / .25); }
  .dir-a .tag { position: relative; z-index: 2; margin: 0 0 14px 18px; font: 500 .6875rem/1.2 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: #d9d2c4; background: rgb(11 10 9 / .75); padding: 6px 10px; }
  .dir-a .hero-copy { max-width: 1200px; margin: clamp(32px, 6vw, 72px) auto 0; padding: 0 clamp(20px, 4vw, 56px); }
  .dir-a h1 { font-size: clamp(2.75rem, 9.5vw, 8.5rem); max-width: 12ch; }
  .dir-a h1 em { color: var(--brass); font-style: italic; }
  .dir-a .sample { margin: 20px 0 0; font-size: .8125rem; color: var(--mute); }

  /* featured work: asymmetric editorial frames */
  .dir-a .feature, .dir-a .case, .dir-a .also { max-width: 1200px; margin: 0 auto; padding: clamp(56px, 9vw, 120px) clamp(20px, 4vw, 56px); border-top: 1px solid var(--rule); }
  .dir-a .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 40px; margin-bottom: clamp(28px, 5vw, 56px); }
  .dir-a .head h2, .dir-a .also h2, .dir-a .case h2 { font-size: clamp(2rem, 5vw, 3.5rem); }
  .dir-a .head p { margin: 0; color: var(--mute); max-width: 40ch; }
  .dir-a .frames { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(20px, 3vw, 40px); align-items: start; }
  .dir-a .frame { margin: 0; }
  .dir-a .frame.big { grid-column: 1 / span 8; grid-row: 1 / span 2; }
  .dir-a .frame.small { grid-column: 9 / span 4; }
  .dir-a .frame.small.off { grid-column: 9 / span 4; }
  .dir-a .ph { position: relative; aspect-ratio: 2.39 / 1; display: grid; place-items: center; text-align: center; padding: 12px; background: linear-gradient(135deg, #1b1713, #100e0c); border: 1px solid var(--rule); color: var(--mute); font: 500 .6875rem/1.4 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .dir-a .frame.small .ph { aspect-ratio: 16 / 10; }
  .dir-a .ph.slot { border-style: dashed; background: transparent; }
  .dir-a figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; padding-top: 14px; }
  .dir-a figcaption .n { font: italic 400 1.125rem/1 var(--serif); color: var(--brass); }
  .dir-a figcaption a, .dir-a figcaption .t { font: 400 1.5rem/1.1 var(--serif); }
  .dir-a figcaption .m { color: var(--mute); font-size: .875rem; flex-basis: 100%; }

  /* sample case-study section: sticky facts, stage frames with roman numerals */
  .dir-a .case { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(28px, 5vw, 80px); }
  .dir-a .case .side { position: sticky; top: 96px; align-self: start; }
  .dir-a .case dl { margin: 28px 0 0; display: grid; gap: 14px; }
  .dir-a .case dt { font: 600 .6875rem/1 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }
  .dir-a .case dd { margin: 4px 0 0; }
  .dir-a .stages { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(28px, 5vw, 56px); }
  .dir-a .stages li { display: grid; grid-template-columns: 3rem 1fr; gap: 6px 18px; }
  .dir-a .stages .n { font: italic 400 1.5rem/1 var(--serif); color: var(--brass); grid-row: 1; }
  .dir-a .stages p { grid-column: 2; margin: 0; color: var(--mute); font-size: .9375rem; max-width: 52ch; }
  .dir-a .also p { color: var(--mute); max-width: 52ch; }
  .dir-a .also .links2 { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 20px; color: var(--bone); }
  .dir-a .also .links2 a { font: 400 1.25rem/1.4 var(--serif); }
  .dir-a .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding: 28px clamp(20px, 4vw, 56px) 40px; border-top: 1px solid var(--rule); color: var(--mute); font: 500 .6875rem/1.4 var(--sans); letter-spacing: .16em; text-transform: uppercase; }

  /* mobile */
  @media (max-width: 760px) {
    .dir-a .top { grid-template-columns: 1fr auto; padding-block: 8px; }
    .dir-a .mark { grid-column: 1; letter-spacing: .26em; font-size: .8125rem; }
    .dir-a .links { display: none; }
    .dir-a .menu { display: block; grid-column: 2; }
    .dir-a .plate { aspect-ratio: 4 / 5; max-height: 62svh; }
    .dir-a .frames { grid-template-columns: 1fr; }
    .dir-a .frame.big, .dir-a .frame.small, .dir-a .frame.small.off { grid-column: 1; margin-top: 0; }
    .dir-a .frame.big .ph { aspect-ratio: 4 / 3; }
    .dir-a .frame.big { grid-row: auto; }
    .dir-a .frame.small .ph { aspect-ratio: 16 / 9; }
    .dir-a .case { grid-template-columns: 1fr; }
    .dir-a .case .side { position: static; }
    .dir-a .stages li { grid-template-columns: 2.25rem 1fr; }
    .dir-a .stages .ph { aspect-ratio: 4 / 3; }
  }

  /* motion: gate opening, copy rise, streak drift, scroll reveal. All off for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .dir-a .plate { animation: gate 1.1s var(--ease) both; }
    .dir-a .hero-copy > * { animation: rise .8s var(--ease) both; }
    .dir-a .hero-copy > :nth-child(1) { animation-delay: .35s; }
    .dir-a .hero-copy > :nth-child(2) { animation-delay: .5s; }
    .dir-a .hero-copy > :nth-child(3) { animation-delay: .65s; }
    .dir-a .streak { animation: drift 14s ease-in-out infinite alternate; }
    .dir-a.js .reveal { opacity: 0; transform: translateY(18px); transition: opacity .6s var(--ease), transform .6s var(--ease); }
    .dir-a.js .reveal.in { opacity: 1; transform: none; }
    @keyframes gate { from { clip-path: inset(32% 0 32% 0); } to { clip-path: inset(0); } }
    @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
    @keyframes drift { from { transform: translateX(-6%); } to { transform: translateX(6%); } }
  }
</style>
