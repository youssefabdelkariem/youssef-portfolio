---
/** Compact speed trace of the validated lap, from the recorded telemetry (every 10th sample, unsmoothed). */
import { lap, best } from '../data/racing';

interface Props { label?: string }
const { label = 'Measured speed along the validated lap' } = Astro.props;
const W = 600, H = 150, pad = 6;
const maxD = 3608, maxV = 300;
const x = (d: number) => pad + (d / maxD) * (W - 2 * pad);
const y = (v: number) => H - pad - (v / maxV) * (H - 2 * pad);
const line = lap.distance.map((d, i) => `${i ? 'L' : 'M'}${x(d).toFixed(1)} ${y(lap.speed[i]).toFixed(1)}`).join('');
const area = `${line}L${x(lap.distance[lap.distance.length - 1]).toFixed(1)} ${y(0)}L${x(lap.distance[0]).toFixed(1)} ${y(0)}Z`;
---

<figure class="spark">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${label}: speed rises and falls through the corners over one ${best.lapLength} kilometre lap, peaking near 294 kilometres per hour.`}>
    <line class="base" x1={pad} x2={W - pad} y1={y(0)} y2={y(0)} />
    <path class="area" d={area} />
    <path class="trace" d={line} />
  </svg>
  <figcaption>{label} &middot; {best.seconds} s lap, {lap.distance.length} recorded samples</figcaption>
</figure>
