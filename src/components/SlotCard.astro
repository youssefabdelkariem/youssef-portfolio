---
interface Props { title: string; note: string }
const { title, note } = Astro.props;
---

<div class="card slot reveal">
  <div class="body">
    <div class="meta"><span class="tag pending">Empty slot</span></div>
    <h3>{title}</h3>
    <p>{note}. Reserved layout; not a project.</p>
  </div>
</div>
