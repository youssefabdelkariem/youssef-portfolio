---
/** Shared case-study header: eyebrow, title, summary and a facts list (role/credits etc.). */
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  facts: { label: string; value: string }[];
}
const { eyebrow, title, lede, facts } = Astro.props;
---

<section class="case-hero">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <dl class="facts">
      {facts.map((f) => (
        <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
      ))}
    </dl>
  </div>
</section>
