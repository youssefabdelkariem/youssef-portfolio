---
import { glint } from '../data/glint';
---

<div class="glint-sim" data-glint-sim>
  <div class="glint-sim-head">
    <div class="fs-sim-title">
      <span class="glint-dot" aria-hidden="true"></span>
      <span class="mono">glint3d/glint-director &middot; ~35s local pipeline</span>
    </div>
    <div class="fs-sim-controls">
      <span class="mono fs-sim-counter" data-glint-counter aria-live="polite">Stage 04 / 04 &middot; Editable Studio</span>
      <button type="button" class="fs-ctrl-btn" data-glint-toggle hidden aria-pressed="false">Pause</button>
      <button type="button" class="fs-ctrl-btn" data-glint-replay hidden>Replay</button>
    </div>
  </div>

  <div class="glint-sim-body">
    <div class="glint-stage-canvas">
      <svg class="glint-svg" viewBox="0 0 640 260" role="img" aria-label="Animated studio rig diagram showing overhead strip softbox light sweep, Bezier camera trajectory, and product silhouette">
        <defs>
          <linearGradient id="glintSweepGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#c9a96e" stop-opacity="0" />
            <stop offset="50%" stop-color="#f5e6c8" stop-opacity="0.32" />
            <stop offset="100%" stop-color="#c9a96e" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="glintFloor" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#1b1713" />
            <stop offset="100%" stop-color="#0b0a09" />
          </linearGradient>
        </defs>

        <!-- Studio backdrop -->
        <rect x="0" y="0" width="640" height="260" fill="#0b0a09" />
        <ellipse cx="320" cy="212" rx="250" ry="32" fill="url(#glintFloor)" stroke="#2e2924" stroke-width="1" />

        <!-- Glint Pass overhead strip softbox + animated sweep -->
        <g class="glint-softbox" data-glint-softbox>
          <rect x="240" y="22" width="160" height="10" rx="2" fill="#f5e6c8" stroke="#c9a96e" stroke-width="1.5" />
          <polygon points="248,32 392,32 450,208 190,208" fill="url(#glintSweepGrad)" opacity="0.7" />
        </g>

        <!-- Product silhouette (sleek automotive / device profile) -->
        <g class="glint-subject">
          <path d="M 190 194 Q 215 148 278 136 L 368 136 Q 422 142 452 184 L 460 198 L 184 198 Z" fill="#141210" stroke="#7a6e5e" stroke-width="1.5" />
          <path class="glint-rim" d="M 212 168 Q 272 138 368 138 Q 414 144 442 176" fill="none" stroke="#c9a96e" stroke-width="2" stroke-linecap="round" />
        </g>

        <!-- Multi-shot Bezier camera trajectory -->
        <path class="glint-cam-path" data-glint-path d="M 110 175 C 165 85, 475 85, 530 175" fill="none" stroke="#c9a96e" stroke-width="1.5" stroke-dasharray="6 5" />

        <!-- Camera markers -->
        <g class="glint-cams">
          <g transform="translate(110, 175)">
            <circle r="6" fill="#0b0a09" stroke="#c9a96e" stroke-width="1.5" />
            <text x="0" y="22" text-anchor="middle" fill="#a39b8d" font-size="11" font-family="monospace">CAM 01</text>
          </g>
          <g transform="translate(320, 108)">
            <circle r="6" fill="#0b0a09" stroke="#c9a96e" stroke-width="1.5" />
            <text x="0" y="-12" text-anchor="middle" fill="#c9a96e" font-size="11" font-family="monospace">MACRO</text>
          </g>
          <g transform="translate(530, 175)">
            <circle r="6" fill="#0b0a09" stroke="#c9a96e" stroke-width="1.5" />
            <text x="0" y="22" text-anchor="middle" fill="#a39b8d" font-size="11" font-family="monospace">CAM 06</text>
          </g>
        </g>
      </svg>

      <div class="glint-readout mono" data-glint-readout aria-live="polite">
        {glint.stages[3].readout}
      </div>
    </div>

    <div class="glint-steps-list" role="tablist" aria-label="Glint 35-second pipeline stages">
      {glint.stages.map((st, idx) => (
        <button
          type="button"
          class:list={['glint-step-btn', idx === 3 && 'is-active']}
          data-glint-step={idx}
          role="tab"
          aria-selected={idx === 3 ? 'true' : 'false'}
        >
          <span class="glint-step-top">
            <span class="mono">{st.step} &middot; {st.label}</span>
            <span class="mono glint-step-dur">{st.duration}</span>
          </span>
          <strong>{st.title}</strong>
          <span class="glint-step-desc">{st.detail}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-glint-sim]').forEach((root) => {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-glint-step]')];
    const counter = root.querySelector<HTMLElement>('[data-glint-counter]');
    const readout = root.querySelector<HTMLElement>('[data-glint-readout]');
    const softbox = root.querySelector<SVGGElement>('[data-glint-softbox]');
    const toggleBtn = root.querySelector<HTMLButtonElement>('[data-glint-toggle]');
    const replayBtn = root.querySelector<HTMLButtonElement>('[data-glint-replay]');

    const readouts = [
      'mesh_bounds: 4.62 x 1.98 x 1.34 m · materials: clearcoat + glass · sub_parts: 6',
      'model: glint3d/glint-director · shots: 6 · mood: silhouette-to-reveal · api_calls: 0',
      'softboxes: 3 animated sweeps · cameras: 6 Bezier rigs · color: AgX',
      'status: Ready · formats: 16:9, 9:16, 1:1 · renderers: Cycles & EEVEE Next',
    ];
    const labels = ['Scene Scan', 'Glint AI Director', 'Rig Build', 'Editable Studio'];
    const shifts = [-48, -16, 22, 0];

    let idx = 3;
    let playing = !reduced;
    let timer: number | undefined;
    let inView = false;

    const render = (step: number) => {
      btns.forEach((b, i) => {
        const active = i === step;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      if (counter) counter.textContent = `Stage 0${step + 1} / 04 · ${labels[step]}`;
      if (readout) readout.textContent = readouts[step];
      if (softbox) {
        softbox.style.transform = `translateX(${shifts[step]}px)`;
      }
      root.dataset.stage = String(step);
    };

    const stop = () => {
      if (timer) window.clearTimeout(timer);
      timer = undefined;
    };

    const scheduleNext = () => {
      if (!playing || !inView || reduced) return;
      timer = window.setTimeout(() => {
        idx = (idx + 1) % 4;
        render(idx);
        scheduleNext();
      }, 2600);
    };

    if (!reduced) {
      if (toggleBtn) toggleBtn.hidden = false;
      if (replayBtn) replayBtn.hidden = false;

      toggleBtn?.addEventListener('click', () => {
        playing = !playing;
        toggleBtn.textContent = playing ? 'Pause' : 'Play';
        toggleBtn.setAttribute('aria-pressed', String(!playing));
        stop();
        if (playing) scheduleNext();
      });

      replayBtn?.addEventListener('click', () => {
        stop();
        idx = 0;
        playing = true;
        if (toggleBtn) {
          toggleBtn.textContent = 'Pause';
          toggleBtn.setAttribute('aria-pressed', 'false');
        }
        render(idx);
        scheduleNext();
      });
    }

    btns.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        stop();
        playing = false;
        if (toggleBtn) {
          toggleBtn.textContent = 'Play';
          toggleBtn.setAttribute('aria-pressed', 'true');
        }
        idx = i;
        render(idx);
      });
    });

    if (!reduced && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          inView = entries[0]?.isIntersecting ?? false;
          stop();
          if (inView && playing) {
            render(idx);
            scheduleNext();
          }
        },
        { threshold: 0.25 }
      );
      io.observe(root);
    } else {
      render(3);
    }
  });
</script>
