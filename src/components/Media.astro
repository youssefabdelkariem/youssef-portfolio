---
/**
 * Media slot. Until a verified asset exists it renders a clearly labelled placeholder
 * (CONTENT_PLAN evidence gate). When `src` is supplied it renders a responsive image
 * with explicit dimensions and meaningful alt text.
 */
interface Props {
  label: string;
  note?: string;
  src?: string;
  alt?: string;
  width?: number;
  height?: number;
  standalone?: boolean;
}
const { label, note = 'Placeholder: asset pending owner verification', src, alt = '', width = 1600, height = 900, standalone = false } = Astro.props;
---

{src ? (
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" style="aspect-ratio: 16 / 9; height: auto; width: 100%;" />
) : (
  <div class:list={['media', { standalone }]} role="img" aria-label={`${label}. ${note}`}>
    <div class="label"><strong>{label}</strong>{note}</div>
  </div>
)}
