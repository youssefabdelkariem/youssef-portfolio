---
/**
 * Speed against distance for the validated lap, drawn at build time from the recorded telemetry in
 * src/data/racing-speed-profile.json (every 10th sample). No smoothing and no invented points. Static SVG, no JavaScript.
 */
import { lap, landmarks, best } from '../data/racing';

const W = 1000, H = 380;
const m = { l: 56, r: 20, t: 34, b: 52 };
const maxD = 3608, maxV = 300;
const x = (d: number) => m.l + (d / maxD) * (W - m.l - m.r);
const y = (v: number) => H - m.b - (v / maxV) * (H - m.t - m.b);
const pts = lap.distance.map((d, i) => [x(d), y(lap.speed[i])] as const);
const line = pts.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`).join('');
const area = `${line}L${pts[pts.length - 1][0].toFixed(1)} ${y(0)}L${pts[0][0].toFixed(1)} ${y(0)}Z`;
const yTicks = [0, 100, 200, 300];
const xTicks = [0, 500, 1000, 1500, 2000, 2500, 3000, 3500];
// Optimisation windows named in the repository README: one band and point markers (metres from the start line).
const band = { a: 330, b: 680 };
const points = [770, 1042, 1528, 1931, 2700];
const fmt = (n: number) => n.toLocaleString('en-US');
const [, top, slow, hp] = landmarks;
const marks = landmarks.slice(1);
---

<figure class="chart reveal">
  <div class="chart-scroll" role="region" aria-label="Speed against distance chart, scrolls sideways on narrow screens" tabindex="0">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="speed-title speed-desc">
      <title id="speed-title">Speed along the validated lap</title>
      <desc id="speed-desc">Recorded speed in kilometres per hour against distance from the start line over one lap of {best.lapLength} kilometres. Speed rises from a standing start to a peak of {top.v.toFixed(1)} kilometres per hour near {fmt(Math.round(top.d))} metres, falls to {slow.v.toFixed(1)} kilometres per hour at the slowest point near {fmt(Math.round(slow.d))} metres, and to {hp.v.toFixed(1)} kilometres per hour at the hairpin near {fmt(Math.round(hp.d))} metres. The table below lists these points.</desc>
      <rect class="band" x={x(band.a)} y={m.t} width={x(band.b) - x(band.a)} height={H - m.t - m.b} />
      {yTicks.map((v) => <g>
        <line class="grid" x1={m.l} x2={W - m.r} y1={y(v)} y2={y(v)} />
        <text x={m.l - 8} y={y(v) + 4} text-anchor="end">{v}</text>
      </g>)}
      {xTicks.map((d) => <g>
        <line class="tick" x1={x(d)} x2={x(d)} y1={H - m.b} y2={H - m.b + 5} />
        <text x={x(d)} y={H - m.b + 19} text-anchor="middle">{fmt(d)}</text>
      </g>)}
      <line class="axis" x1={m.l} x2={W - m.r} y1={H - m.b} y2={H - m.b} />
      <line class="axis" x1={m.l} x2={m.l} y1={m.t} y2={H - m.b} />
      <path class="area" d={area} />
      <path class="trace" d={line} pathLength="1" />
      {points.map((d) => <g>
        <line class="tick" x1={x(d)} x2={x(d)} y1={m.t - 6} y2={m.t + 2} />
        <text x={x(d)} y={m.t - 10} text-anchor="middle">{fmt(d)}</text>
      </g>)}
      <text x={(x(band.a) + x(band.b)) / 2} y={m.t - 10} text-anchor="middle">330–680</text>
      {marks.map((k) => <g>
        <circle class="mark" cx={x(k.d)} cy={y(k.v)} r="4.5" />
      </g>)}
      <text x={(m.l + W - m.r) / 2} y={H - 8} text-anchor="middle">Distance from the start line (m)</text>
      <text x="14" y={(m.t + H - m.b) / 2} text-anchor="middle" transform={`rotate(-90 14 ${(m.t + H - m.b) / 2})`}>Speed (km/h)</text>
    </svg>
  </div>
  <figcaption>
    <strong>Measured.</strong> Recorded telemetry of the {best.seconds} s lap, every 10th sample. The shaded band and the ticks along the top mark the corner windows
    the optimiser searched (positions as listed in the repository README). Circles mark the points in the table below.
  </figcaption>
</figure>
