---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreakdownViewer from '../components/BreakdownViewer.astro';
import { passes } from '../data/aurelia-passes';
import { walkthrough, published } from '../data/walkthrough';

const preview = !published; // local draft preview: never deployed, never indexed
const ready = walkthrough.sections.filter((s) => s.status === 'ready' || preview);
---

<BaseLayout title="Aurelia: the making of" description="How the Aurelia One CGI commercial was built: scene and lighting, render passes, compositing, colour management and delivery." noindex={preview}>
  <div class="wrap page-title">
    <p class="eyebrow">VFX Portfolio / Aurelia</p>
    <h1>{walkthrough.title}</h1>
    <p class="lede">{walkthrough.lede}</p>
    <p><a href="/work/aurelia/">Back to the Aurelia case study</a></p>
  </div>

  <section class="section" style="padding-top:0" aria-labelledby="toc">
    <div class="wrap">
      <h2 id="toc">In this walkthrough</h2>
      <ol class="inside">
        {ready.map((s, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><div><a href={`#${s.id}`}>{s.title}</a></div></li>)}
      </ol>
    </div>
  </section>

  {ready.map((s, i) => (
    <section class="section divided" aria-labelledby={s.id}>
      <div class="wrap">
        <p class="eyebrow">{String(i + 1).padStart(2, '0')}</p>
        <h2 id={s.id}>{s.title}</h2>
        {s.summary && <p class="lede">{s.summary}</p>}
        {s.points.length > 0 && (
          <ul class="chips" style="display:grid;gap:var(--s-3);list-style:none;padding:0">
            {s.points.map((p) => <li style="border-radius:var(--r-2);padding:var(--s-3) var(--s-4)">{p.text} <small style="color:var(--text-2)">Source: {p.source}.</small></li>)}
          </ul>
        )}
        {s.id === 'passes' && <div style="margin-top:var(--s-5)"><BreakdownViewer name="passes" legend="Render pass" stages={passes} /></div>}
        {preview && s.status !== 'ready' && <p class="notice"><strong>Draft, internal.</strong> Needs: {s.need.join('; ')}</p>}
        {preview && s.media.filter((m) => m.status === 'needed').map((m) => <p class="notice"><strong>Media needed.</strong> {m.description}</p>)}
      </div>
    </section>
  ))}
</BaseLayout>
